# Server Configuration
PORT=3000
NODE_ENV=development

# Facebook Meta Graph API Configuration
FACEBOOK_GRAPH_VERSION=v26.0
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here
FACEBOOK_APP_SECRET=your_app_secret_here
FACEBOOK_VERIFY_TOKEN=your_webhook_verify_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# Optional: Messenger PSIDs allowed to run admin commands like /post (comma-separated).
# When empty, admin commands are only allowed while NODE_ENV=development.
FACEBOOK_ADMIN_PSIDS=
