{
  "name": "facebook-page-bot",
  "version": "1.0.0",
  "description": "Production-grade Facebook Pages & Bot API service built with Node.js, Express, and TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "postinstall": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "facebook",
    "pages-api",
    "bot",
    "meta",
    "graph-api",
    "typescript",
    "express"
  ],
  "author": "Developer",
  "license": "MIT",
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "strip-json-comments": "^5.0.3",
    "typescript": "^5.7.2",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}
